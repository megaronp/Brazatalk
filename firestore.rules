rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check with bootstrapped verified owner
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'megaronp@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Helper function to check if the user is a member or owner of the specified server
    function isServerMember(serverId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/servers/$(serverId)) &&
        (
          get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid ||
          (get(/databases/$(database)/documents/servers/$(serverId)).data.memberIds is list &&
           get(/databases/$(database)/documents/servers/$(serverId)).data.memberIds.hasAny([request.auth.uid])) ||
          get(/databases/$(database)/documents/servers/$(serverId)).data.isPublic == true ||
          isAdmin()
        )
      );
    }

    // Users Collection: users can only manage their own profile document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Servers Collection: restricted to members, owners, public hubs, and admin
    match /servers/{serverId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberIds is list && resource.data.memberIds.hasAny([request.auth.uid])) ||
        resource.data.isPublic == true ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Project Rooms (Workspace / Autonomous AI development rooms)
    // Strictly scoped to server members with mandatory serverId (fail-closed)
    match /projectRooms/{channelId} {
      allow read: if isAuthenticated() && (
        (resource != null && 'serverId' in resource.data && resource.data.serverId != null && isServerMember(resource.data.serverId)) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.channelId == channelId &&
        ('serverId' in request.resource.data && request.resource.data.serverId != null && isServerMember(request.resource.data.serverId)) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (resource != null && 'serverId' in resource.data && resource.data.serverId != null && isServerMember(resource.data.serverId)) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (resource != null && 'serverId' in resource.data && resource.data.serverId != null && isServerMember(resource.data.serverId)) ||
        isAdmin()
      );

      // Granular per-file documents strictly scoped to parent projectRoom's serverId
      match /files/{fileId} {
        allow read: if isAuthenticated() && (
          (exists(/databases/$(database)/documents/projectRooms/$(channelId)) &&
           'serverId' in get(/databases/$(database)/documents/projectRooms/$(channelId)).data &&
           get(/databases/$(database)/documents/projectRooms/$(channelId)).data.serverId != null &&
           isServerMember(get(/databases/$(database)/documents/projectRooms/$(channelId)).data.serverId)) ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          (exists(/databases/$(database)/documents/projectRooms/$(channelId)) &&
           'serverId' in get(/databases/$(database)/documents/projectRooms/$(channelId)).data &&
           get(/databases/$(database)/documents/projectRooms/$(channelId)).data.serverId != null &&
           isServerMember(get(/databases/$(database)/documents/projectRooms/$(channelId)).data.serverId)) ||
          isAdmin()
        );
      }
    }

    // Messages: strictly scoped under servers/{serverId}/channels/{channelId}/messages
    // Root /messages collection is closed to prevent cross-server data leaks
    match /servers/{serverId}/channels/{channelId}/messages/{messageId} {
      allow read: if isServerMember(serverId);
      allow create: if isServerMember(serverId) && (
        request.resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isServerMember(serverId) && (
        // Author editing own message (authorId and channelId must be strictly immutable)
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.authorId == resource.data.authorId &&
         request.resource.data.channelId == resource.data.channelId) ||
        // Other members of the server can only toggle reactions or pin status
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned'])) ||
        isAdmin()
      );
      allow delete: if isServerMember(serverId) && (
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
