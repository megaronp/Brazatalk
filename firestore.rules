rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check with bootstrapped verified owner
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'megaronp@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Users Collection: users can only manage their own profile document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Servers Collection: community servers and guilds
    match /servers/{serverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Project Rooms (Workspace / Autonomous AI development rooms)
    match /projectRooms/{channelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.channelId == channelId;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();

      // Granular per-file documents to eliminate collaborative clobbering
      match /files/{fileId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // Messages Collection: authenticated messages, author edit rules, and reactions
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        // Author editing own message (authorId and channelId must be strictly immutable)
        ((resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid) &&
         request.resource.data.authorId == resource.data.authorId &&
         request.resource.data.channelId == resource.data.channelId) ||
        // Other users can only toggle reactions or pin status
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Subcollection messages inside servers/channels
    match /servers/{serverId}/channels/{channelId}/messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        ((resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid) &&
         request.resource.data.authorId == resource.data.authorId &&
         request.resource.data.channelId == resource.data.channelId) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pinned'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
